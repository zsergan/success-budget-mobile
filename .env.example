# Copy to .env.local (gitignored) and restart with `npx expo start --clear`.
# Leave both unset to use the hosted dev backend in development.

# Which backend to talk to: local | dev | prod (URLs live in
# src/shared/constants.ts). Defaults to dev in development builds and prod
# in release builds.
EXPO_PUBLIC_API_ENV=local

# An explicit URL instead of one of the environments above. Any non-local
# value MUST use https:// (enforced at startup).
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
